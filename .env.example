# ──────────────────────────────────────────────────────────────────────
# Kulvé environment variables
#
# RULE: any var prefixed with VITE_ gets bundled into the client JS and is
#       VISIBLE TO ANYONE in dev tools. Only put public/safe values there.
#       Everything else (paid API keys, secrets) MUST NOT have VITE_ prefix
#       — those stay server-side only.
# ──────────────────────────────────────────────────────────────────────


# ── PUBLIC (safe in client bundle — designed to be exposed) ──
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your_anon_key_here"
VITE_GOOGLE_CLIENT_ID="your_google_oauth_client_id.apps.googleusercontent.com"
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_..."
VITE_UNSPLASH_ACCESS_KEY="your_unsplash_access_key"


# ── SECRET (server-side only — never prefix with VITE_) ──

# Anthropic — used by /api/ai/generate proxy
ANTHROPIC_API_KEY="sk-ant-..."

# Lead-gen APIs — used by /api/leads/* proxies
GOOGLE_PLACES_API_KEY="your_google_places_key"
APOLLO_API_KEY="your_apollo_key"
SERPER_API_KEY="your_serper_key"

# Admin password — used by /api/admin/auth (server-side check only)
ADMIN_PASSWORD="pick_a_strong_password"

# Email (Resend) — used by /api/send-email
RESEND_API_KEY="re_..."

# Supabase service role — used by server for admin operations (RLS bypass)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your_service_role_key_here"

# Stripe (server)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_TRIAL=""
STRIPE_PRICE_BASIC=""
STRIPE_PRICE_OPERATOR=""
STRIPE_PRICE_SCALE=""
STRIPE_PRICE_BRAND_KIT=""


# ── App ──
APP_URL="http://localhost:3000"
